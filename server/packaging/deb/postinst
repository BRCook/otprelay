#!/bin/sh
set -e

case "$1" in
configure)
    if ! getent group otprelay >/dev/null; then
        addgroup --system otprelay
    fi
    if ! getent passwd otprelay >/dev/null; then
        adduser --system --ingroup otprelay --home /var/lib/otprelay \
            --no-create-home --shell /usr/sbin/nologin \
            --gecos "otprelay relay" otprelay
    fi
    # The database lives here and is private to the service user.
    mkdir -p /var/lib/otprelay
    chown otprelay:otprelay /var/lib/otprelay
    chmod 700 /var/lib/otprelay

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable --now otprelay.service >/dev/null 2>&1 || true
    fi
    ;;
esac