# Configuration for otprelay. Copy to /etc/default/otprelay.

# Address and port to listen on. Behind a reverse proxy, the proxy
# points at this. Use 127.0.0.1 if the proxy runs on the same machine.
OTPRELAY_HOST=0.0.0.0
OTPRELAY_PORT=8787

# Database location (managed by systemd's StateDirectory).
OTPRELAY_DB=/var/lib/otprelay/otprelay.db

# Optional: serve TLS directly (only if no reverse proxy handles it).
#OTPRELAY_TLS_CERT=/etc/otprelay/fullchain.pem
#OTPRELAY_TLS_KEY=/etc/otprelay/privkey.pem

PYTHONUNBUFFERED=1
