<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- otprelay's preferences hold this phone's relay token and the public key
         of every paired computer. They stay on the device: a new phone should
         register with its own invite and pair its own computers. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="otprelay.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="otprelay.xml" />
    </device-transfer>
</data-extraction-rules>